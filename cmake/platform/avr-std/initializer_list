// Minimal <initializer_list> for avr-gcc, which ships without a C++ standard library
//
// The compiler constructs std::initializer_list itself through the private (pointer, length) constructor, so the
// member layout and constructor must match libstdc++'s exactly.
#ifndef AVR_STD_INITIALIZER_LIST
#define AVR_STD_INITIALIZER_LIST

#pragma GCC system_header

namespace std {
template <typename E>
class initializer_list {
  public:
    typedef E value_type;
    typedef const E& reference;
    typedef const E& const_reference;
    typedef decltype(sizeof(0)) size_type;
    typedef const E* iterator;
    typedef const E* const_iterator;

  private:
    iterator _M_array;
    size_type _M_len;

    // Called by the compiler
    constexpr initializer_list(const_iterator a, size_type l) : _M_array(a), _M_len(l) {}

  public:
    constexpr initializer_list() noexcept : _M_array(0), _M_len(0) {}
    constexpr size_type size() const noexcept { return _M_len; }
    constexpr const_iterator begin() const noexcept { return _M_array; }
    constexpr const_iterator end() const noexcept { return begin() + size(); }
};

template <typename E>
constexpr const E* begin(initializer_list<E> il) noexcept {
    return il.begin();
}

template <typename E>
constexpr const E* end(initializer_list<E> il) noexcept {
    return il.end();
}
}  // namespace std
#endif
