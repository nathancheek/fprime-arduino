// Minimal <initializer_list> for avr-gcc, which ships without a C++ standard library. The compiler constructs
// std::initializer_list directly, so the layout and private constructor must match libstdc++'s.
#ifndef AVR_STD_INITIALIZER_LIST
#define AVR_STD_INITIALIZER_LIST
#include <stddef.h>
namespace std {
template <class E>
class initializer_list {
  public:
    typedef E value_type;
    typedef const E& reference;
    typedef const E& const_reference;
    typedef size_t size_type;
    typedef const E* iterator;
    typedef const E* const_iterator;

    constexpr initializer_list() noexcept : m_array(nullptr), m_len(0) {}
    constexpr size_type size() const noexcept { return m_len; }
    constexpr const_iterator begin() const noexcept { return m_array; }
    constexpr const_iterator end() const noexcept { return m_array + m_len; }

  private:
    constexpr initializer_list(const_iterator array, size_type len) : m_array(array), m_len(len) {}
    iterator m_array;
    size_type m_len;
};

template <class E>
constexpr const E* begin(initializer_list<E> list) noexcept {
    return list.begin();
}
template <class E>
constexpr const E* end(initializer_list<E> list) noexcept {
    return list.end();
}
}  // namespace std
#endif
